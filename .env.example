# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xynvvoh.mongodb.net/ai_code_explainer?retryWrites=true&w=majority

# Gemini AI API Key (Default)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Optional, Recommended for ultra-fast 0.5s inference with Llama 3.3)
GROQ_API_KEY=your_groq_api_key_here

# xAI Grok API Key (Optional)
GROK_API_KEY=your_xai_grok_key_here

# Google OAuth 2.0 Client ID (for Google Sign In)
GOOGLE_CLIENT_ID=your_google_client_id_here

# App Environment & Port
PORT=5000
NODE_ENV=development
API_SECRET_KEY=generate_a_random_secure_secret_here

